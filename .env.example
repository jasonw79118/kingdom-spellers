# Kingdom Spellers 2.0 — environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# The app runs in DEMO MODE (localStorage) with none of these set, so you
# can develop and test without any backend.

# ---------------------------------------------------------------------------
# Appwrite  ← current backend
# ---------------------------------------------------------------------------
# Project: 6abacd6a001d4161641f  ·  Region: Frankfurt (fra)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6abacd6a001d4161641f
VITE_APPWRITE_DB_ID=kingdom

# Only needed to run the one-time schema setup script (never shipped to the
# browser — it is NOT prefixed with VITE_). Get it from:
# Appwrite Console → your project → Settings → API Keys → Create API Key
# (scope: "Any")
APPWRITE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase  ← optional alternative (ignored when Appwrite is configured)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Text-to-speech
# ---------------------------------------------------------------------------
# The device's built-in voices work with no setup at all. For genuinely natural
# speech on every device, add a free ElevenLabs key — see README "Reading
# voices". Keys can also be pasted into the in-app voice picker at runtime, so
# this file is optional.
#
# VITE_TTS_PROVIDER: auto (default) | cloud | local
VITE_TTS_PROVIDER=auto
# Which cloud service to use: elevenlabs (default) | google
VITE_TTS_CLOUD=elevenlabs
# Recommended: a serverless proxy URL so the key never reaches the browser.
VITE_TTS_PROXY=
# Fallback: a browser-visible key. Anyone can extract it, so prefer a proxy.
# VITE_ELEVENLABS_API_KEY=
# VITE_GOOGLE_TTS_KEY=

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
# "/" for a root domain, "/kingdom-spellers/" for GitHub Pages
VITE_BASE=/kingdom-spellers/
