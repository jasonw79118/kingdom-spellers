# Kingdom Spellers 2.0 — environment configuration
#
# The app runs in DEMO MODE (localStorage backend) when these are not set,
# so you can develop and test without a Supabase project.
#
# To go live with real accounts + cloud data, create a free project at
# https://supabase.com, then paste the values below into a file named `.env`
# and restart the dev server. The full database schema (with Row Level
# Security) is in supabase/schema.sql — run it in the Supabase SQL editor.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to "/kingdom-spellers/" for GitHub Pages, "/" for a root domain
VITE_BASE=/kingdom-spellers/
