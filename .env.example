# Kingdom Spellers 2.0 — environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# The app runs in DEMO MODE (localStorage) with none of these set, so you
# can develop and test without any backend.

# ---------------------------------------------------------------------------
# Appwrite  ← current backend
# ---------------------------------------------------------------------------
# Project: 6abacd6a001d4161641f  ·  Region: Frankfurt (fra)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6abacd6a001d4161641f
VITE_APPWRITE_DB_ID=kingdom

# Only needed to run the one-time schema setup script (never shipped to the
# browser — it is NOT prefixed with VITE_). Get it from:
# Appwrite Console → your project → Settings → API Keys → Create API Key
# (scope: "Any")
APPWRITE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase  ← optional alternative (ignored when Appwrite is configured)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
# "/" for a root domain, "/kingdom-spellers/" for GitHub Pages
VITE_BASE=/kingdom-spellers/
